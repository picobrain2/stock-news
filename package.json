{
  "name": "sihwang-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prefetch": "esbuild scripts/prefetch.ts --bundle --platform=node --format=esm --outfile=scripts/.prefetch.mjs && node scripts/.prefetch.mjs",
    "build": "tsc --noEmit && vite build",
    "build:site": "npm run prefetch && npm run build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
